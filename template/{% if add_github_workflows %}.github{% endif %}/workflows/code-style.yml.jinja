name: Code Style

on:
  pull_request:
  push:
    branches:
      - main
      - master

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  style:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

{%- if setup_translations %}

      # The update-translations hook needs {{ 'pylupdate5' if qgis_version == 'QGIS3' else 'pylupdate6' }}
      - name: Install Qt translation tools
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends {{ 'pyqt5-dev-tools' if qgis_version == 'QGIS3' else 'pyqt6-dev-tools' }}
{%- endif %}

      - name: Run prek
        uses: j178/prek-action@4e14d07f9231acabce116ccfca13b13dd9755ece # v3.0.0
