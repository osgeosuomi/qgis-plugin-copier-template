name: Code Style

on:
  pull_request:
  push:
    branches:
      - main
      - master
  workflow_call:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-style-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  style:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

{%- if setup_translations %}

      # The update-translations hook needs {{ 'pylupdate5' if qgis_version == 'QGIS3' else 'pylupdate6' }}
      - name: Install Qt translation tools
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends {{ 'pyqt5-dev-tools' if qgis_version == 'QGIS3' else 'pyqt6-dev-tools' }}
{%- endif %}

      - name: Run prek
        uses: j178/prek-action@4e14d07f9231acabce116ccfca13b13dd9755ece # v3.0.0

  commit-messages:
    if: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {% raw %}${{ github.event.pull_request.head.sha }}{% endraw %}
          fetch-depth: 0

      - name: Install uv
        uses: astral-sh/setup-uv@bec219d24cd3e171d82865faccec33120bb574f4 # v10.1.0

      - name: Lint commit messages
        env:
          BASE_SHA: {% raw %}${{ github.event.pull_request.base.sha }}{% endraw %}
        run: uvx --from gitlint-core==0.19.1 gitlint --commits "${BASE_SHA}..HEAD"
