[build-system]
requires = ["setuptools", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ qgis_plugin_module | replace('_', '-') | lower }}"
requires-python = ">=3.12,<3.14"
dynamic = [
  "version",
]
readme = "README.md"
dependencies = [
  "qgis_plugin_tools",
]

[project.entry-points."qgis_plugin_dev_tools"]
{{ qgis_plugin_module }} = "{{ qgis_plugin_module }}"

[tool.setuptools.dynamic]
version = { attr = "{{ qgis_plugin_module }}.__version__" }

[tool.setuptools.packages.find]
where = ["src"]
include = ["{{ qgis_plugin_module }}*"]
namespaces = true

[tool.qgis_plugin_dev_tools]
plugin_package_name = "{{ qgis_plugin_module }}"
runtime_requires = ["qgis_plugin_tools"]
version_number_source = "distribution"

[tool.uv]
default-groups = ["dev", "lint"]

[dependency-groups]
dev = [
    # Debugging
    "debugpy==1.5.1",
    # Testing
    "pytest>=9.1.1",
    # Tools
    "qgis-plugin-dev-tools",
    "copier",
]
lint = [
    # Linting and formatting (ensure precommit yaml has same versions)
    "prek>=0.5.1",
    "ruff>=0.16.5",
    "mypy>=2",
    "flake8>=7.3.0",
    # flake8 plugins
    "flake8-qgis>=2.0.0",
    "flake8-pyproject>=1.2.4",
    "flake8-spellcheck>=0.28.0",
    # Stubs for type checks
    "PyQt5-stubs==5.15.6.0",
]

[tool.ruff]
target-version = "py312"
line-length = 88

lint.ignore = [
    "FIX", # flake8-fixme
    "TD002", # Missing author in TODO
    "D104", # Missing docstring in public package
    "D105", # Missing docstring in magic method
    "D107", # Missing docstring in `__init__`
    {%- if not insert_copyright_header %}
    "CPY", # flake8-copyright (CPY)
    {%- endif %}
    # Conflicting rules (formatter)
    "D203", # one-blank-line-before-class, D211 used (no-blank-line-before-class)
    "D213", # multi-line-summary-second-line, D212 used (multi-line-summary-first-line)
    "COM812", # missing-trailing-comma (formatter will enforce this)
    "ISC001", # single-line-implicit-string-concatenation
]

# List of all rules https://docs.astral.sh/ruff/rules/
lint.select = ["ALL"]

lint.unfixable = [
    "F401", # Unused imports
    "F841", # Unused variables
]

# Avoid flagging (and removing) `SC200` from any `# noqa`
# directives, despite Ruff's lack of support for `flake8-spellcheck`.
# Also, select QGIS3 compatible rules for now (QGS2 are for QGIS4).
lint.external = ["SC200", "QGS1"]

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.isort]
known-first-party = ["{{ qgis_plugin_module }}"]

[tool.ruff.lint.per-file-ignores]
"{test,test_integration,test_e2e}/*" = [
    "INP001",
    "D", # pydocstyle
    "DTZ", # flake8-datetimez
    "FBT", # flake8-boolean-trap
    "TD", # flake8-todos
    "S", # flake8-bandit
    "SLF", # flake8-self
    "ANN201", # Missing return type annotation for public function
    "E501", # Line too long
    "C901", # Function is too complex
    "PLR2004", # Magic value used in comparison, consider replacing `2000` with a constant variable
    "PLR0912", # Too many branches
    "PLR0913", # Too many arguments in function definition
    "PLR0915", # Too many statements
    "ARG001", # Unused function argument
]

[tool.flake8]
max-line-length = 88
spellcheck-targets = "names"
dictionaries = "en_US,python,technical"
select = ["SC", "QGS"]
per-file-ignores = [
    "test/*:SC200,QGS",
    "test_integration/*:SC200,QGS",
    "test_e2e/*:SC200,QGS",
]

[tool.mypy]
python_version = "3.12"
follow_imports = "normal"
show_column_numbers = true
check_untyped_defs = true
