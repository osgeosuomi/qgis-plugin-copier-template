{% import "includes/plugin_lint.jinja" as plugin_lint with context -%}
[build-system]
requires = ["uv_build>=0.12.15,<0.13"]
build-backend = "uv_build"

[project]
name = "{{ qgis_plugin_module | replace('_', '-') | lower }}"
requires-python = ">={{ python_version }}"
version = "0.0.0.post0"
readme = "README.md"
dependencies = ["qgis_plugin_tools"]
build = ["uv"]

[project.entry-points."qgis_plugin_dev_tools"]
{{ qgis_plugin_module }} = "{{ qgis_plugin_module }}"

[tool.uv.build-backend]
module-name = "{{ qgis_plugin_module }}"
include = [
  "py.typed",
  "metadata.txt",
  "resources/**/*",
  "**/*.svg",
  "**/*.ts",
  "**/*.ui",
]

[tool.qgis_plugin_dev_tools]
plugin_package_name = "{{ qgis_plugin_module }}"
runtime_requires = ["qgis_plugin_tools"]
version_number_source = "pyproject"
{%- if monorepo_component %}
changelog_file_path = "{{ root_rel }}/CHANGELOG.md"
env_file_path = "{{ root_rel }}/.env"
{%- endif %}
{%- if setup_translations %}
translation_language_codes = ["{{ lang_key_for_translations }}"]
translation_search_paths = ["src/{{ qgis_plugin_module }}"]
translation_destination_path = "src/{{ qgis_plugin_module }}/resources/i18n"
{%- if qgis_version != 'QGIS3' %}
translation_pylupdate_command = "pylupdate6"
{%- endif %}
{%- endif %}

[tool.uv]
default-groups = ["dev", "lint"]

[dependency-groups]
dev = [
  # Debugging
  "debugpy==1.5.1",
  # Testing
  "pytest>=9.1.1",
  "pytest-qt",
  "pytest-qgis",
  "pytest-mock",
  # Tools
  "qgis-plugin-dev-tools>=0.13.0",
  "copier",
]
lint = [
  # Linting and formatting (ensure precommit yaml has same versions)
  "prek>=0.5.1",
  "ruff>=0.16.8",
  "mypy>=2",
  "flake8>=7.3.0",
  # flake8 plugins
  "flake8-qgis>=2.1.0",
  "flake8-pyproject>=1.2.4",
  "flake8-spellcheck>=0.28.0",
  # Stubs for type checks
  {%- if qgis_version == 'QGIS3' %}
  "PyQt5-stubs==5.15.6.0",
  {%- else %}
  "PyQt6-stubs==20250824",
  {%- endif %}
]

{% if monorepo_component -%}
[tool.ruff]
# extend is required for editor/isort actions to pick up the root configuration
extend = "{{ root_rel }}/pyproject.toml"

# Replaces the codes of the root configuration instead of adding to them
lint.external = ["SC200", {% if qgis_version == 'QGIS3' %}"QGS1"{% else %}"QGS"{% endif %}]

[tool.ruff.lint.isort]
known-first-party = ["{{ qgis_plugin_module }}"]

# flake8 does not inherit the root configuration
[tool.flake8]
max-line-length = 88
select = [{% if qgis_version == 'QGIS3' %}"QGS1"{% else %}"QGS"{% endif %}]
per-file-ignores = ["test/*:QGS"]
{%- else -%}
[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 88

lint.ignore = [{{ plugin_lint.as_toml(plugin_lint.RUFF_LINT_IGNORE) }}
]

# List of all rules https://docs.astral.sh/ruff/rules/
lint.select = ["ALL"]

lint.unfixable = [
  "F401", # Unused imports
  "F841", # Unused variables
]

# Avoid flagging (and removing) `SC200` from any `# noqa`
# directives, despite Ruff's lack of support for `flake8-spellcheck`.
lint.external = ["SC200", {% if qgis_version == 'QGIS3' %}"QGS1"{% else %}"QGS"{% endif %}]

[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.isort]
known-first-party = ["{{ qgis_plugin_module }}"]

[tool.ruff.lint.per-file-ignores]
"{test,test_integration,test_e2e}/*" = [{{ plugin_lint.as_toml(plugin_lint.RUFF_TEST_IGNORE) }}
]

[tool.flake8]
max-line-length = 88
spellcheck-targets = "names"
dictionaries = "en_US,python,technical"
select = ["SC", {% if qgis_version == 'QGIS3' %}"QGS1"{% else %}"QGS"{% endif %}]
per-file-ignores = [
  "test/*:SC200,QGS",
  "test_integration/*:SC200,QGS",
  "test_e2e/*:SC200,QGS",
]

[tool.bandit]
exclude_dirs = ["test"]

[tool.mypy]
python_version = "{{ python_version }}"
follow_imports = "normal"
show_column_numbers = true
check_untyped_defs = true
{%- endif %}
