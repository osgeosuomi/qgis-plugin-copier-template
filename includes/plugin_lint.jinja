{#-
  Lint rules the generated plugin sources rely on, rendered into the plugin
  configuration and into the monorepo root tests. Import with context.
-#}

{#- Rule groups, rendered as toml with the comments aligned per group, like taplo -#}
{%- set RUFF_LINT_IGNORE = [
    {"rules": [
        ("FIX", "flake8-fixme"),
        ("TD002", "Missing author in TODO"),
        ("D100", "Missing docstring in public module"),
        ("D104", "Missing docstring in public package"),
        ("D105", "Missing docstring in magic method"),
        ("D107", "Missing docstring in `__init__`"),
    ] + ([("CPY", "flake8-copyright (CPY)")] if not insert_copyright_header else [])},
    {"comment": "Conflicting rules (formatter)", "rules": [
        ("D203", "one-blank-line-before-class, D211 used (no-blank-line-before-class)"),
        ("D213", "multi-line-summary-second-line, D212 used (multi-line-summary-first-line)"),
        ("COM812", "missing-trailing-comma (formatter will enforce this)"),
        ("ISC001", "single-line-implicit-string-concatenation"),
        ("UP037", "quoted-annotation (quoted annotations are used with TYPE_CHECKING imports)"),
    ]},
] -%}

{%- set RUFF_TEST_IGNORE = [
    {"rules": [
        ("INP001", ""),
        ("D", "pydocstyle"),
        ("DTZ", "flake8-datetimez"),
        ("FBT", "flake8-boolean-trap"),
        ("TD", "flake8-todos"),
        ("S", "flake8-bandit"),
        ("SLF", "flake8-self"),
        ("ANN201", "Missing return type annotation for public function"),
        ("E501", "Line too long"),
        ("C901", "Function is too complex"),
        ("PLR2004", "Magic value used in comparison, consider replacing `2000` with a constant variable"),
        ("PLR0912", "Too many branches"),
        ("PLR0913", "Too many arguments in function definition"),
        ("PLR0915", "Too many statements"),
        ("ARG001", "Unused function argument"),
    ]},
] -%}

{%- set SPELLCHECK_WORDS = ["i18n", "iface", "qgis", "teardown", "truthy", "utils"] -%}

{% macro as_toml(groups) %}
{%- for group in groups %}
{%- if group.comment %}
  # {{ group.comment }}
{%- endif %}
{%- set width = (group.rules | map(attribute=0) | map('length') | max) + 3 %}
{%- for code, comment in group.rules %}
{%- if comment %}
  {{ ("%-" ~ width ~ "s") | format('"' ~ code ~ '",') }} # {{ comment }}
{%- else %}
  "{{ code }}",
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endmacro %}

{% macro as_python(groups) %}
{%- for group in groups %}
{%- for code, comment in group.rules %}
    "{{ code }}",
{%- endfor %}
{%- endfor %}
{%- endmacro %}

{% macro words_per_line() %}
{%- for word in SPELLCHECK_WORDS %}
{{ word }}
{%- endfor %}
{%- endmacro %}
